MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/craftora?retryWrites=true&w=majority
JWT_SECRET=<any long random string>
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=
PORT=5000

# Live frontend address (no trailing slash). Used for CORS and Stripe redirects.
# Leave empty for local development.
FRONTEND_URL=

# Forgot-password and contact-form emails (Gmail + app password)
EMAIL_USER=
EMAIL_PASS=
# Where contact-form messages are delivered (defaults to EMAIL_USER)
CONTACT_EMAIL=

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
